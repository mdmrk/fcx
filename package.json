{
  "name": "fcx",
  "version": "0.5.0",
  "author": "mdmrk",
  "packageManager": "pnpm@11.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdmrk/fcx.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "lightningcss": "^1.33.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bugs": {
    "url": "https://github.com/mdmrk/fcx/issues"
  },
  "description": "Mejora la navegación en ForoCoches.",
  "homepage": "https://github.com/mdmrk/fcx#readme",
  "license": "GNU General Public License v3.0",
  "scripts": {
    "build": "tsx build.ts",
    "build:watch": "tsx build.ts --dev --watch",
    "build:greasyfork": "biome lint && tsc --noEmit && tsx build.ts --release-channel GitHubRelease",
    "clean": "rm -rf dist",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "dev": "tsx build.ts --dev --server --watch",
    "dev:hot": "bash scripts/dev-hot.sh"
  },
  "type": "module",
  "userscriptHeader": {
    "@name": "FCX",
    "@match": [
      "https://forocoches.com/*"
    ],
    "@grant": [
      "GM_getValue",
      "GM_setValue",
      "GM_addStyle",
      "GM_registerMenuCommand"
    ],
    "@run-at": "document-end",
    "@noframes": true
  }
}
